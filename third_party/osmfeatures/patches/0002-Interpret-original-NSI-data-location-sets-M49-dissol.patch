 private val QID = Regex("Q\\d+")
+
+private val COUNTRY = Regex("[a-z]{2}")
+private val SUBDIVISION = Regex("([a-z]{2})-([a-z0-9]{1,3})(\\.geojson)?")
+
+/** Countries for which the app distinguishes subdivisions when looking for features (e.g. "US-NY").
+ *  For all other countries, features that are restricted to subdivisions are treated as available
+ *  in the whole country. */
+private val SUPPORTED_SUBDIVISIONS = setOf("us", "ca", "in", "au", "cn")
