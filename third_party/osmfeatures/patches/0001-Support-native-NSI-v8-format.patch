diff --git a/src/commonMain/kotlin/de/westnordost/osmfeatures/NsiJsonParser.kt b/src/commonMain/kotlin/de/westnordost/osmfeatures/NsiJsonParser.kt
new file mode 100644
index 0000000..6b55854
--- /dev/null
+++ b/src/commonMain/kotlin/de/westnordost/osmfeatures/NsiJsonParser.kt
@@ -0,0 +1,206 @@
+package de.westnordost.osmfeatures
+
+import kotlinx.io.Source
+import kotlinx.serialization.ExperimentalSerializationApi
+import kotlinx.serialization.json.*
+import kotlinx.serialization.json.io.decodeFromSource
+
+/** Parses the name suggestion index in its own format
+ *  [...](https://cdn.jsdelivr.net/npm/name-suggestion-index/dist/json/nsi.json)
+ *  into list of (brand) Features.
+ *
+ *  Each NSI item is turned into a feature based on the iD preset it belongs to, in the same way as
+ *  `buildIDPresets()` in name-suggestion-index/lib/presets_id.ts does it.
+ *
+ *  Additionally to the NSI format, items may have `"searchable": false`, e.g. to mark brands that
+ *  are dissolved (see name-suggestion-index/dist/wikidata/dissolved.json). */
+internal class NsiJsonParser(private val presets: Map<String, Feature>) {
+
+    @OptIn(ExperimentalSerializationApi::class)
+    fun parse(source: Source): List<BaseFeature> =
+        parse(Json.decodeFromSource<JsonObject>(source))
+
+    fun parse(content: String): List<BaseFeature> =
+        parse(Json.decodeFromString<JsonObject>(content))
+
+    private fun parse(json: JsonObject): List<BaseFeature> {
+        // the categories in the nsi.json are one level down (in nsi object)
+        val root = json["nsi"]?.jsonObject ?: json
+        val result = ArrayList<BaseFeature>()
+        for ((tkv, category) in root) {
+            val (t, k, v) = tkv.split('/', limit = 3)
+            val tree = TREES[t] ?: continue
+            val items = category.jsonObject.getValue("items").jsonArray
+            val properties = category.jsonObject["properties"]?.jsonObject
+            // ferries are both a route relation and a ferry route way
+            val presetPaths =
+                if (tkv == "transit/route/ferry") listOf("type/route/ferry", "route/ferry")
+                else listOf(getPresetPath(k, v))
+            for (presetPath in presetPaths) {
+                val childPresets = presets.values.filter { it.id.startsWith(presetPath) }
+                for (item in items) {
+                    parseFeature(item.jsonObject, tree, k, childPresets, properties)?.let { result.add(it) }
+                }
+            }
+        }
+        return result
+    }
+
+    private fun parseFeature(
+        item: JsonObject,
+        tree: NsiTree,
+        k: String,
+        childPresets: List<Feature>,
+        properties: JsonObject?
+    ): BaseFeature? {
+        val itemTags = item["tags"]!!.jsonObject.mapValues { it.value.jsonPrimitive.content }
+        val qid = itemTags[tree.mainTag]
+        if (qid == null || !QID.matches(qid)) return null
+
+        val preset = pickBestChildPreset(childPresets, itemTags) ?: presets[k] ?: return null
+
+        // all tags of the preset (with values of the item, if set) plus the main tag. Wildcard tags
+        // of the preset for which the item has no value remain wildcards
+        val tags = buildMap {
+            put(tree.mainTag, qid)
+            for ((key, value) in preset.tags) put(key, itemTags[key] ?: value)
+            for (key in preset.tagKeys) itemTags[key]?.let { put(key, it) }
+        }
+        val tagKeys = preset.tagKeys - itemTags.keys
+
+        val include = item["locationSet"]?.jsonObject?.get("include")?.jsonArray
+        val exclude = item["locationSet"]?.jsonObject?.get("exclude")?.jsonArray
+        val includeCountryCodes =
+            if (include != null) include.parseCountryCodes() ?: return null
+            else emptyList()
+        val excludeCountryCodes =
+            if (exclude != null) exclude.parseCountryCodes() ?: return null
+            else emptyList()
+
+        val preserveTags = (item["preserveTags"] ?: properties?.get("preserveTags"))
+            ?.jsonArray?.map { Regex(it.jsonPrimitive.content) }.orEmpty()
+
+        return BaseFeature(
+            id = "${preset.id}/${item["id"]!!.jsonPrimitive.content}",
+            tags = tags,
+            geometry = preset.geometry,
+            icon = preset.icon,
+            names = listOf(item["displayName"]!!.jsonPrimitive.content),
+            terms = collectTerms(item, itemTags, tree),
+            includeCountryCodes = includeCountryCodes,
+            excludeCountryCodes = excludeCountryCodes,
+            isSearchable = item["searchable"]?.jsonPrimitive?.booleanOrNull ?: true,
+            matchScore = 2.0f,
+            isSuggestion = true,
+            addTags = itemTags + tags,
+            preserveTags = preserveTags,
+            tagKeys = tagKeys,
+        )
+    }
+
+    private fun pickBestChildPreset(childPresets: List<Feature>, tags: Map<String, String>): Feature? {
+        if (childPresets.size == 1) return childPresets[0]
+
+        var matchTagsCount = 0
+        var matchSemicolonRating = 0
+        var match: Feature? = null
+        for (preset in childPresets) {
+            // presets with wildcard tags can't match, as NSI items don't have tags with "*" values
+            if (preset.tagKeys.isNotEmpty()) continue
+            var semicolonRating = 0
+            val isMatch = preset.tags.all { (osmKey, osmValue) ->
+                val nsiValue = tags[osmKey] ?: return@all false
+                if (osmKey in SEMICOLON_SPLIT_KEYS) {
+                    val index = nsiValue.split(';').indexOf(osmValue)
+                    if (index == -1) return@all false
+                    semicolonRating -= index
+                    true
+                } else {
+                    osmValue == nsiValue
+                }
+            }
+            val tagsCount = preset.tags.size
+            if (isMatch && (
+                tagsCount > matchTagsCount ||
+                tagsCount == matchTagsCount && semicolonRating > matchSemicolonRating
+            )) {
+                matchTagsCount = tagsCount
+                matchSemicolonRating = semicolonRating
+                match = preset
+            }
+        }
+        return match
+    }
+
+    private fun collectTerms(item: JsonObject, tags: Map<String, String>, tree: NsiTree): List<String> {
+        val terms = LinkedHashSet<String>()
+        item["matchNames"]?.jsonArray?.mapTo(terms) { it.jsonPrimitive.content }
+        for ((key, value) in tags) {
+            if (key == "name") continue
+            if (NOT_NAME.containsMatchIn(key)) continue
+            if (tree.primaryName.containsMatchIn(key) || tree.alternateName.containsMatchIn(key)) {
+                terms.add(value.lowercase())
+            }
+        }
+        return terms.toList()
+    }
+
+    private fun getPresetPath(k: String, v: String): String {
+        if (k == "route") return "type/route/$v"
+        val kv = "$k/$v"
+        return PRESET_PATH_OVERRIDES[kv] ?: kv
+    }
+}
+
+private class NsiTree(val mainTag: String, primaryName: String, alternateName: String) {
+    val primaryName = Regex(primaryName, RegexOption.IGNORE_CASE)
+    val alternateName = Regex(alternateName, RegexOption.IGNORE_CASE)
+}
+
+// from name-suggestion-index/config/trees.json
+private val TREES = mapOf(
+    "brands" to NsiTree(
+        mainTag = "brand:wikidata",
+        primaryName = "^(name|name:[\\w-]+)$",
+        alternateName = "^(brand|brand:[\\w-]+|brand:short:[\\w-]+|operator|operator:[\\w-]+|operator:short:[\\w-]+|\\w+_name|\\w+_name:[\\w-]+)$"
+    ),
+    "flags" to NsiTree(
+        mainTag = "flag:wikidata",
+        primaryName = "^(flag:name|flag:name:[\\w-]+)$",
+        alternateName = "^(country|country:[\\w-]+|flag|flag:[\\w-]+|subject|subject:[\\w-]+)$"
+    ),
+    "operators" to NsiTree(
+        mainTag = "operator:wikidata",
+        primaryName = "^(name|name:[\\w-]+|operator|operator:[\\w-]+)$",
+        alternateName = "^(brand|brand:[\\w-]+|brand:short:[\\w-]+|operator:short:[\\w-]+|\\w+_name|\\w+_name:[\\w-]+)$"
+    ),
+    "transit" to NsiTree(
+        mainTag = "network:wikidata",
+        primaryName = "^network$",
+        alternateName = "^(operator|operator:[\\w-]+|operator:short:[\\w-]+|network:[\\w-]+|network:short:[\\w-]+|\\w+_name|\\w+_name:[\\w-]+)$"
+    ),
+)
+
+// from name-suggestion-index/lib/presets_id.ts
+private val PRESET_PATH_OVERRIDES = mapOf(
+    "highway/bus_stop" to "public_transport/platform/bus_point",
+    "amenity/ferry_terminal" to "public_transport/station_ferry",
+    "amenity/college" to "education/college",
+    "amenity/driving_school" to "education/driving_school",
+    "amenity/dancing_school" to "education/dancing_school",
+    "amenity/kindergarten" to "education/kindergarten",
+    "amenity/language_school" to "education/language_school",
+    "amenity/music_school" to "education/music_school",
+    "amenity/prep_school" to "education/prep_school",
+    "amenity/school" to "education/school",
+    "amenity/university" to "education/university",
+    "emergency/water_rescue" to "emergency/lifeboat_station",
+)
+
+private val SEMICOLON_SPLIT_KEYS = setOf(
+    "beauty", "clothes", "cuisine", "healthcare:speciality", "social_facility", "sport", "vending", "waste"
+)
+
+private val NOT_NAME = Regex(":(colour|type|left|right|etymology|pronunciation|wikipedia|wikidata)$", RegexOption.IGNORE_CASE)
+
+private val QID = Regex("Q\\d+")
