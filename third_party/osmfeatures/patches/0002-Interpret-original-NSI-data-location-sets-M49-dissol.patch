+private fun List<JsonElement>.toCountryCodes(): List<String>? {
+    val result = LinkedHashSet<String>()
+    for (element in this) result.addAll(element.toCountryCodes() ?: return null)
+    return result.toList()
+}
+
+/** null if not supported, empty if worldwide. Circles are arrays, GeoJSON files are not ISO 3166 codes */
+private fun JsonElement.toCountryCodes(): List<String>? {
+    val code = (this as? JsonPrimitive)?.takeIf { it.isString }?.content ?: return null
+    if (code == "001" || code == "Planet") return emptyList()
+    if (COUNTRY.matches(code)) return listOf(code.uppercase())
+    SUBDIVISION.matchEntire(code)?.let { match ->
+        val country = match.groupValues[1]
+        return listOf(
+            if (country in SUPPORTED_SUBDIVISIONS) "${country.uppercase()}-${match.groupValues[2].uppercase()}"
+            else country.uppercase()
+        )
+    }
+    return expandM49(code)
+}
+
+private fun expandM49(code: String): List<String>? =
+    M49Codes[code]?.flatMap { if (it.all(Char::isDigit)) expandM49(it).orEmpty() else listOf(it) }
+
 private class NsiTree(val mainTag: String, primaryName: String, alternateName: String) {
     val primaryName = Regex(primaryName, RegexOption.IGNORE_CASE)
     val alternateName = Regex(alternateName, RegexOption.IGNORE_CASE)
